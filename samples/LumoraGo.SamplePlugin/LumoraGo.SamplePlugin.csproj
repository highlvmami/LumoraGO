<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <IsPackable>false</IsPackable>
    <!-- Eklenti klasörüne bağımlılıklarıyla birlikte kopyalanabilsin. -->
    <EnableDynamicLoading>true</EnableDynamicLoading>
  </PropertyGroup>

  <ItemGroup>
    <!-- LumoraGo bu derlemeyi kendisi sağlar; eklenti klasörüne kopyalanmasın. -->
    <ProjectReference Include="..\..\src\LumoraGo.Plugin.Abstractions\LumoraGo.Plugin.Abstractions.csproj">
      <Private>false</Private>
      <ExcludeAssets>runtime</ExcludeAssets>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="plugin.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
