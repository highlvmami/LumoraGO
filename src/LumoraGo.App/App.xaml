<Application x:Class="LumoraGo.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <!-- Faz 5'te temalar ResourceDictionary dosyalarına taşınacak -->
        <SolidColorBrush x:Key="WindowBackground" Color="#F2202020" />
        <SolidColorBrush x:Key="WindowBorder" Color="#33FFFFFF" />
        <SolidColorBrush x:Key="PrimaryText" Color="#FFF3F3F3" />
        <SolidColorBrush x:Key="SecondaryText" Color="#FF9E9E9E" />
        <SolidColorBrush x:Key="SelectedBackground" Color="#26FFFFFF" />
        <SolidColorBrush x:Key="AccentBrush" Color="#FF7C9CFF" />
    </Application.Resources>
</Application>
