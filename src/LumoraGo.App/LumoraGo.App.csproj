<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Sadece tepsi simgesi (NotifyIcon) ve Screen için -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Linux/macOS'ta da derlenebilsin (çalıştırmak yine Windows ister) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LumoraGo</AssemblyName>
    <RootNamespace>LumoraGo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF ve WinForms aynı adları (Application, KeyEventArgs...) taşıdığı için WinForms'u global using'den çıkar -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumoraGo.Core\LumoraGo.Core.csproj" />
  </ItemGroup>

</Project>
