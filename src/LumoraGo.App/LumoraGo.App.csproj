<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <!-- Sadece tepsi simgesi (NotifyIcon) ve Screen için -->
    <UseWindowsForms>true</UseWindowsForms>
    <!-- Linux/macOS'ta da derlenebilsin (çalıştırmak yine Windows ister) -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <AssemblyName>LumoraGo</AssemblyName>
    <RootNamespace>LumoraGo.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <TieredPGO>true</TieredPGO>
    <!-- Velopack ilk iş çalışmalı; Main'i Program.cs'te kendimiz yazıyoruz -->
    <StartupObject>LumoraGo.App.Program</StartupObject>
    <!-- Exe, görev çubuğu ve tepsi simgesi -->
    <ApplicationIcon>Assets\LumoraGo.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- WPF ve WinForms aynı adları (Application, KeyEventArgs...) taşıdığı için WinForms'u global using'den çıkar -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <!-- /version sürüm notlarını buradan okur -->
    <EmbeddedResource Include="..\..\CHANGELOG.md" LogicalName="CHANGELOG.md" />
  </ItemGroup>

  <ItemGroup>
    <Resource Include="Assets\LumoraGo.ico" />
    <Resource Include="Assets\logo-64.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LumoraGo.Core\LumoraGo.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

</Project>
