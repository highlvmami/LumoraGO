<Window x:Class="LumoraGo.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:LumoraGo.App.Converters"
        Title="LumoraGo"
        Width="720"
        SizeToContent="Height"
        WindowStyle="None"
        ResizeMode="NoResize"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        Topmost="True"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

    <!-- Çerçevesiz ama katmanlı (AllowsTransparency) değil: böylece Windows 11 akrilik arka planı, yuvarlak köşeleri
         ve gölgeyi DWM çizer. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" GlassFrameThickness="-1" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <conv:ResultIconConverter x:Key="ResultIcon" />
        <FontFamily x:Key="IconFont">Segoe Fluent Icons, Segoe MDL2 Assets</FontFamily>

        <Style x:Key="KeyCap" TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource KeyCapBackground}" />
            <Setter Property="CornerRadius" Value="4" />
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="10,0,4,0" />
        </Style>

        <Style x:Key="ResultItemStyle" TargetType="ListBoxItem">
            <!-- Odak her zaman arama kutusunda kalsın -->
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bg" Background="Transparent" CornerRadius="6" Margin="0,1">
                            <Grid>
                                <!-- Windows 11 tarzı seçim çubuğu -->
                                <Border x:Name="Pill" Width="3" Height="18" CornerRadius="1.5" HorizontalAlignment="Left"
                                        Background="{DynamicResource AccentBrush}" Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBackground}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bg" Property="Background" Value="{DynamicResource SelectedBackground}" />
                                <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Border x:Name="Root"
            Background="{DynamicResource WindowBackground}"
            BorderBrush="{DynamicResource WindowBorder}"
            BorderThickness="1"
            CornerRadius="8">
        <Border.RenderTransform>
            <TranslateTransform x:Name="RootOffset" />
        </Border.RenderTransform>

        <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel x:Name="MainColumn" Width="718" VerticalAlignment="Top">
            <!-- Arama satırı -->
            <Grid Margin="16,10,16,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock Text="&#xE721;"
                           FontFamily="{StaticResource IconFont}"
                           FontSize="18"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource AccentBrush}" />

                <!-- Soluk tamamlama önerisi: yazılan kısım görünmez, devamı soluk. TextBox'ın iç boşluğuyla hizalı. -->
                <TextBlock Grid.Column="1"
                           Margin="12,6,110,6"
                           VerticalAlignment="Center"
                           FontSize="22"
                           IsHitTestVisible="False"
                           TextTrimming="None">
                    <Run Text="{Binding QueryText, Mode=OneWay}" Foreground="Transparent" /><Run Text="{Binding GhostSuffix, Mode=OneWay}" Foreground="{DynamicResource GhostText}" />
                </TextBlock>

                <TextBox x:Name="QueryBox"
                         Grid.Column="1"
                         Text="{Binding QueryText, UpdateSourceTrigger=PropertyChanged}"
                         FontSize="22"
                         Padding="10,6,110,6"
                         Background="Transparent"
                         BorderThickness="0"
                         Foreground="{DynamicResource PrimaryText}"
                         CaretBrush="{DynamicResource AccentBrush}"
                         SelectionBrush="{DynamicResource AccentBrush}" />

                <!-- Sağda şeffaf marka yazısı; tıklamaları kutuya bırakır -->
                <TextBlock Grid.Column="1"
                           Text="LumoraGo"
                           HorizontalAlignment="Right"
                           VerticalAlignment="Center"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource PrimaryText}"
                           Opacity="0.25"
                           IsHitTestVisible="False" />
            </Grid>

            <StackPanel Visibility="{Binding HasResults, Converter={StaticResource BoolToVisibility}}">
                <Border Height="1" Background="{DynamicResource Divider}" />

                <ListBox x:Name="ResultsList"
                         ItemsSource="{Binding Results}"
                         SelectedIndex="{Binding SelectedIndex, Mode=TwoWay}"
                         Focusable="False"
                         Margin="8,6"
                         MaxHeight="440"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         ItemContainerStyle="{StaticResource ResultItemStyle}"
                         PreviewMouseLeftButtonUp="ResultsList_OnPreviewMouseLeftButtonUp">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="48" Margin="10,0,10,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="40" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <ContentControl Width="28" Height="28" HorizontalAlignment="Left" Focusable="False"
                                                Content="{Binding Converter={StaticResource ResultIcon}}" />

                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Title}"
                                               FontSize="15"
                                               Foreground="{DynamicResource PrimaryText}"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Subtitle}"
                                               FontSize="12"
                                               Margin="0,1,0,0"
                                               Foreground="{DynamicResource SecondaryText}"
                                               TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <!-- Seçili satırda Enter ipucu -->
                                <Border x:Name="EnterHint" Grid.Column="2" Style="{StaticResource KeyCap}" VerticalAlignment="Center" Visibility="Collapsed">
                                    <TextBlock Text="Enter ↵" FontSize="11" Foreground="{DynamicResource SecondaryText}" />
                                </Border>
                            </Grid>
                            <DataTemplate.Triggers>
                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}" Value="True">
                                    <Setter TargetName="EnterHint" Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Alt bilgi çubuğu -->
                <Border Height="1" Background="{DynamicResource Divider}" />
                <Grid Margin="16,7,16,8">
                    <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource SecondaryText}"
                               Text="{Binding Results.Count, StringFormat={}{0} sonuç}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <StackPanel.Resources>
                            <Style TargetType="TextBlock">
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="VerticalAlignment" Value="Center" />
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
                            </Style>
                        </StackPanel.Resources>
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="↑↓" /></Border>
                        <TextBlock Text="gez" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Tab" /></Border>
                        <TextBlock Text="tamamla" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Ctrl+Enter" /></Border>
                        <TextBlock Text="klasör" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="→" /></Border>
                        <TextBlock Text="eylemler" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Shift+Boşluk" /></Border>
                        <TextBlock Text="önizle" />
                        <Border Style="{StaticResource KeyCap}"><TextBlock Text="Esc" /></Border>
                        <TextBlock Text="kapat" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </StackPanel>

        <!-- Hızlı önizleme (Shift+Boşluk); içerik koddan PreviewPane ile gelir -->
        <Border x:Name="PreviewColumn" Grid.Column="1" Width="420" Visibility="Collapsed"
                BorderThickness="1,0,0,0" BorderBrush="{DynamicResource Divider}" VerticalAlignment="Top" />
        </Grid>
    </Border>
</Window>
