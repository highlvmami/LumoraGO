<Window x:Class="LumoraGo.App.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="LumoraGo ayarları"
        Width="560" Height="680"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,18,0,6" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,2,0,6" />
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="Margin" Value="0,4" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
        <Style TargetType="ListBox">
            <Setter Property="Height" Value="76" />
            <Setter Property="Background" Value="{DynamicResource KeyCapBackground}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}" />
            <Setter Property="BorderBrush" Value="{DynamicResource Divider}" />
        </Style>
    </Window.Resources>

    <DockPanel Margin="20,8,20,16">
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="İptal" IsCancel="True" />
            <Button x:Name="SaveButton" Content="Kaydet" IsDefault="True" Margin="0" Click="Save_OnClick" />
        </StackPanel>

        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="Kısayol" Style="{StaticResource Heading}" />
                <TextBox x:Name="HotkeyBox" IsReadOnly="True" Width="220" HorizontalAlignment="Left" Padding="6,4"
                         PreviewKeyDown="HotkeyBox_OnPreviewKeyDown" />
                <TextBlock Style="{StaticResource Note}" Text="Kutuya tıklayıp yeni tuş birleşimine bas (örn. Ctrl+Shift+Space)." />

                <TextBlock Text="Görünüm" Style="{StaticResource Heading}" />
                <ComboBox x:Name="ThemeBox" Width="220" HorizontalAlignment="Left">
                    <ComboBoxItem Content="Koyu" />
                    <ComboBoxItem Content="Açık" />
                    <ComboBoxItem Content="Windows'u takip et" />
                </ComboBox>
                <CheckBox x:Name="StartupBox" Content="Windows açılışında başlat" Margin="0,10,0,0" />

                <TextBlock Text="Pano geçmişi (/c)" Style="{StaticResource Heading}" />
                <CheckBox x:Name="ClipboardBox" Content="Kopyaladıklarımı hatırla" />
                <CheckBox x:Name="ClipboardPersistBox" Content="Kapatınca da hatırla (diske kaydet)" Margin="0,6,0,0"
                          IsEnabled="{Binding IsChecked, ElementName=ClipboardBox}" />
                <TextBlock Style="{StaticResource Note}" Text="İkinci kutu kapalıyken geçmiş sadece bellekte tutulur, LumoraGo kapanınca silinir. Açıkken son 200 kopya %LOCALAPPDATA%\LumoraGo\clipboard.json dosyasına yazılır. Kutuyu kapatınca dosya silinir; geçmişi tamamen kapatınca mevcut geçmiş de temizlenir." />

                <TextBlock Text="Derin arama (/ds) klasörleri" Style="{StaticResource Heading}" />
                <ListBox x:Name="DeepFoldersList" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Klasör ekle" Click="AddDeepFolder_OnClick" />
                    <Button Content="Kaldır" Click="RemoveDeepFolder_OnClick" />
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="Liste boşsa tüm sabit diskler (C:\, D:\...) aranır." />

                <CheckBox x:Name="DeepIncludeSystemBox" Content="Sistem klasörlerini de ara (Windows, Program Files, AppData, node_modules, .git)" Margin="0,8,0,0" />
                <TextBlock Style="{StaticResource Note}" Text="Kapalıyken bu klasörler atlanır, arama hızlı biter. Açıkken C:\ içindeki her şey taranır, bu çok daha uzun sürer; $Recycle.Bin ve System Volume Information yine atlanır." />

                <TextBlock Text="Derin aramada atlanacak klasör adları" Style="{StaticResource Heading}" />
                <TextBox x:Name="SkipNamesBox" Padding="6,4" />
                <TextBlock x:Name="DefaultSkipNote" Style="{StaticResource Note}" />

                <TextBlock Text="Dosya arama (/f) ek klasörleri" Style="{StaticResource Heading}" />
                <ListBox x:Name="FileFoldersList" />
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <Button Content="Klasör ekle" Click="AddFileFolder_OnClick" />
                    <Button Content="Kaldır" Click="RemoveFileFolder_OnClick" />
                </StackPanel>
                <TextBlock Style="{StaticResource Note}" Text="Masaüstü, Belgeler, İndirilenler, Resimler, Videolar, Müzik ve OneDrive her zaman taranır." />

                <TextBlock Text="Özel kısayollar" Style="{StaticResource Heading}" />
                <TextBox x:Name="CustomShortcutsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="90"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" Padding="6,4" />
                <TextBlock Style="{StaticResource Note}" Text="Her satıra bir kısayol: &quot;kelime | hedef&quot; veya &quot;kelime | ad | hedef&quot;. Hedef bir site, dosya, klasör ya da uygulama olabilir. Hedefte {0} varsa kelimeden sonra yazılan metin oraya konur. Örnek: /okul | Okul portalı | https://okul.example.com, ekşi | https://eksisozluk.com/?q={0}" />

                <TextBlock Text="Takvim (/takvim)" Style="{StaticResource Heading}" />
                <TextBox x:Name="CalendarUrlsBox" AcceptsReturn="True" TextWrapping="NoWrap" MinHeight="60"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                         FontFamily="Cascadia Mono, Consolas" Padding="6,4" />
                <TextBlock Style="{StaticResource Note}" Text="Her satıra bir takvimin gizli ICS adresi. Google Takvim: takvim ayarları → &quot;Takvimi entegre et&quot; → &quot;iCal biçiminde gizli adres&quot;. Outlook.com: Ayarlar → Takvim → Paylaşılan takvimler → Takvim yayımla → ICS bağlantısı. Adresi bilen herkes takvimi okuyabilir; bu yüzden şifreli (Windows hesabına bağlı) saklanır ve yalnızca takvim indirmek için kullanılır." />

                <TextBlock Text="Mail (/mail)" Style="{StaticResource Heading}" />
                <TextBlock Text="Mail adresi" Margin="0,0,0,2" />
                <TextBox x:Name="MailAddressBox" Padding="6,4" />
                <TextBlock Text="Şifre (Gmail için uygulama şifresi)" Margin="0,8,0,2" />
                <PasswordBox x:Name="MailPasswordBox" Padding="6,4" />
                <TextBlock x:Name="MailPasswordNote" Style="{StaticResource Note}" />
                <TextBlock Text="IMAP sunucusu (Gmail, Yahoo, Yandex, iCloud için boş bırak)" Margin="0,8,0,2" />
                <TextBox x:Name="MailServerBox" Padding="6,4" />
                <TextBlock Style="{StaticResource Note}" Text="Gmail: Google hesabında 2 adımlı doğrulamayı aç, myaccount.google.com/apppasswords adresinden bir uygulama şifresi üret ve buraya yapıştır; normal şifren çalışmaz. Gmail'de IMAP'in açık olması gerekir (Ayarlar → Tüm ayarlar → Yönlendirme ve POP/IMAP). Outlook, Hotmail ve Microsoft 365 desteklenmiyor. Mailler okundu işaretlenmez, yalnızca gönderen ve konu okunur. Şifre Windows hesabına bağlı şifreli dosyada tutulur. Adresi boşaltıp kaydedersen hesap silinir." />
            </StackPanel>
        </ScrollViewer>
    </DockPanel>
</Window>
