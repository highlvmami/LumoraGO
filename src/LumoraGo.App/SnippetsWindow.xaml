<Window x:Class="LumoraGo.App.SnippetsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:ClassModifier="internal"
        Title="Hazır metinler"
        Icon="pack://application:,,,/Assets/LumoraGo.ico"
        Width="900" Height="620" MinWidth="720" MinHeight="460"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Foreground="{DynamicResource PrimaryText}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Margin" Value="0,10,0,4" />
        </Style>
        <Style x:Key="Note" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SecondaryText}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="6,4" />
        </Style>
    </Window.Resources>

    <Grid Margin="16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="280" MinWidth="200" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Sol: liste -->
        <DockPanel Grid.Column="0">
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" TextChanged="SearchBox_OnTextChanged" ToolTip="Ad, kısa ad, kategori veya içerikte ara" />
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Yeni" Click="New_OnClick" />
                <Button Content="Çoğalt" Click="Duplicate_OnClick" />
                <Button x:Name="DeleteButton" Content="Sil" Click="Delete_OnClick" />
            </StackPanel>
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="İçe aktar" Click="Import_OnClick" />
                <Button Content="Dışa aktar" Click="Export_OnClick" />
            </StackPanel>
            <ListBox x:Name="SnippetList" Margin="0,8,0,0" SelectionChanged="SnippetList_OnSelectionChanged"
                     Background="{DynamicResource KeyCapBackground}" Foreground="{DynamicResource PrimaryText}"
                     BorderBrush="{DynamicResource Divider}" HorizontalContentAlignment="Stretch">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" Foreground="{DynamicResource AccentBrush}" Margin="4,8,0,2" />
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="2,3">
                            <DockPanel>
                                <TextBlock DockPanel.Dock="Right" Text="{Binding Keyword}" Foreground="{DynamicResource SecondaryText}" FontFamily="Cascadia Mono, Consolas" />
                                <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                            </DockPanel>
                            <TextBlock Text="{Binding Preview}" Foreground="{DynamicResource SecondaryText}" FontSize="11.5" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <GridSplitter Grid.Column="1" Width="12" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" />

        <!-- Sağ: düzenleyici -->
        <DockPanel Grid.Column="2" x:Name="EditorPanel">
            <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <TextBlock x:Name="StatusText" VerticalAlignment="Center" Margin="0,0,12,0" Foreground="{DynamicResource SecondaryText}" />
                <Button Content="Kapat" IsCancel="True" Click="Close_OnClick" />
                <Button x:Name="SaveButton" Content="Kaydet" Margin="0" Click="Save_OnClick" ToolTip="Ctrl+S" />
            </StackPanel>

            <Grid DockPanel.Dock="Top">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="10" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0">
                    <TextBlock Text="Ad" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <TextBox x:Name="NameBox" TextChanged="Field_OnChanged" />
                </StackPanel>
                <StackPanel Grid.Column="2">
                    <TextBlock Text="Kısa ad" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <TextBox x:Name="KeywordBox" FontFamily="Cascadia Mono, Consolas" TextChanged="Field_OnChanged"
                             ToolTip="Launcher'a bunu yazıp Enter'a basınca metin yapıştırılır, örn. ;adres" />
                </StackPanel>
                <StackPanel Grid.Column="4">
                    <TextBlock Text="Kategori" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <ComboBox x:Name="CategoryBox" IsEditable="True" Padding="6,4"
                              TextBoxBase.TextChanged="Field_OnChanged" />
                </StackPanel>
            </Grid>

            <StackPanel DockPanel.Dock="Top">
                <TextBlock x:Name="KeywordNote" Style="{StaticResource Note}" />
                <TextBlock Text="İçerik" Style="{StaticResource Label}" />
                <WrapPanel x:Name="PlaceholderPanel" Margin="0,0,0,6" />
            </StackPanel>

            <Grid DockPanel.Dock="Bottom" Margin="0,8,0,0">
                <StackPanel>
                    <TextBlock Text="Önizleme (yapıştırılınca böyle görünür)" Style="{StaticResource Label}" Margin="0,0,0,4" />
                    <Border Background="{DynamicResource KeyCapBackground}" BorderBrush="{DynamicResource Divider}" BorderThickness="1"
                            Padding="8,6" MaxHeight="130">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PreviewText" TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Border>
                    <TextBlock x:Name="UsageText" Style="{StaticResource Note}" />
                </StackPanel>
            </Grid>

            <TextBox x:Name="ContentBox" AcceptsReturn="True" AcceptsTab="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" MinHeight="120" VerticalContentAlignment="Top"
                     TextChanged="Field_OnChanged" />
        </DockPanel>
    </Grid>
</Window>
