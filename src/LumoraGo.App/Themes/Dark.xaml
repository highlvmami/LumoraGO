<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Akrilik arka plan varken yarı saydam, yokken (Windows 10) ThemeService opak sürümünü kullanır -->
    <Color x:Key="WindowBackgroundColor">#99202020</Color>
    <Color x:Key="WindowBackgroundOpaqueColor">#FF202020</Color>
    <SolidColorBrush x:Key="WindowBackground" Color="#99202020" />
    <SolidColorBrush x:Key="WindowBorder" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="PrimaryText" Color="#FFF3F3F3" />
    <SolidColorBrush x:Key="SecondaryText" Color="#FF9E9E9E" />
    <SolidColorBrush x:Key="SelectedBackground" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF7C9CFF" />
    <SolidColorBrush x:Key="Divider" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="KeyCapBackground" Color="#14FFFFFF" />
</ResourceDictionary>
