<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\LumoraGo.Core\LumoraGo.Core.csproj" />
    <!-- Örnek eklenti sadece önce derlensin diye; testler onu dış eklenti gibi klasörden yükler. -->
    <ProjectReference Include="..\..\samples\LumoraGo.SamplePlugin\LumoraGo.SamplePlugin.csproj" ReferenceOutputAssembly="false" Private="false" />
  </ItemGroup>

  <!-- Örnek eklentinin çıktısını test çıktısında extensions/merhaba klasörüne kopyala. -->
  <Target Name="CopySamplePlugin" AfterTargets="Build">
    <MSBuild Projects="..\..\samples\LumoraGo.SamplePlugin\LumoraGo.SamplePlugin.csproj" Targets="GetTargetPath" Properties="Configuration=$(Configuration)">
      <Output TaskParameter="TargetOutputs" ItemName="SamplePluginPath" />
    </MSBuild>
    <ItemGroup>
      <SamplePluginFiles Include="%(SamplePluginPath.RootDir)%(SamplePluginPath.Directory)**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(SamplePluginFiles)" DestinationFiles="@(SamplePluginFiles->'$(OutDir)extensions\merhaba\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
  </Target>

</Project>